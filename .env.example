# Klucz API Anthropic (Claude): włącza matchmaking z AI (rozumienie opisu + dostęp do aktualnych pomysłów).
# Bez klucza matchmaking działa lokalnie (TF-IDF), a asystenci w trybie offline.
ANTHROPIC_API_KEY=
# Klucz Gemini (Google AI Studio) – alternatywa dla Claude. Przy obu kluczach domyślnie Gemini; wybór: AI_PROVIDER=claude|gemini.
GEMINI_API_KEY=
AI_PROVIDER=
# Opcjonalnie: model Gemini (domyślnie gemini-3.5-flash) i zapasowy przy przeciążeniu (domyślnie gemini-2.5-flash).
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
# Ustaw HUB_AI=off, żeby wyłączyć AI mimo ustawionego klucza (np. do testów E2E).
HUB_AI=
# Hasło do panelu administratora (tylko prototyp! W produkcji: SSO/OIDC). Domyślnie: demo
ADMIN_DEMO_PASSWORD=
# Opcjonalne: adres webhooka, na który trafia każde zdarzenie (nowa fiszka, wniosek, zmiana naboru…)
NOTIFY_WEBHOOK_URL=
# Opcjonalne: stałe klucze VAPID dla powiadomień push aplikacji administratora (npx web-push generate-vapid-keys).
# Bez nich klucze generują się przy starcie, a aplikacja sama odnawia subskrypcję po restarcie serwera.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hub@example.org
